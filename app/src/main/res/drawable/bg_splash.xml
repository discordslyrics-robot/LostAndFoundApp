<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Same deep galaxy base as home -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0A0E27"
                android:centerColor="#1A1040"
                android:endColor="#0D1B4B"
                android:angle="135" />
        </shape>
    </item>

    <!-- Center glowing orb -->
    <item
        android:top="100dp"
        android:left="60dp"
        android:right="60dp"
        android:bottom="200dp">
        <shape android:shape="oval">
            <solid android:color="#2A1A7E" />
        </shape>
    </item>

</layer-list>
