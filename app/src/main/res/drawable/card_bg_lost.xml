<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC2D1B1B" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:bottom="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#40F43F5E" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
